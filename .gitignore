############################################
# 0) 默认全忽略（白名单模式）
############################################
*
!.gitignore
!.gitattributes
!README.md
!LICENSE

############################################
# 1) 只允许三个模块目录进入版本库
############################################
!speaking_service/
!vocab_service/
!streamlit_wrt_app/

# 允许目录结构继续向下被规则控制
!speaking_service/**
!vocab_service/**
!streamlit_wrt_app/**

############################################
# 1.5) 允许 gateway 与 scripts 进入版本库
############################################
!gateway/
!gateway/**
!scripts/
!scripts/**

############################################
# 2) 通用：Python / Node / 系统垃圾 / IDE
############################################
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/ENV/
**/.env
**/.env.*
**/*.log
!.env.example

# macOS / Windows
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/*.tmp
**/*.bak
**/*.swp
**/*.swo

# IDE
**/.vscode/
**/.idea/

############################################
# 3) streamlit_wrt_app：强制忽略敏感和运行产物
############################################
streamlit_wrt_app/.streamlit/secrets.toml
streamlit_wrt_app/.streamlit/*.toml

# 运行/输出
streamlit_wrt_app/reports/
streamlit_wrt_app/out/
streamlit_wrt_app/output/
streamlit_wrt_app/tmp/
streamlit_wrt_app/logs/
streamlit_wrt_app/storage/

# 你明确说的旧文件（避免误提交）
streamlit_wrt_app/streamlit_wrt_app.py
streamlit_wrt_app/streamlit_wrt_app2.py
streamlit_wrt_app/app2.py
streamlit_wrt_app/grader2.py

# 中文“新建文本文档”之类
streamlit_wrt_app/*.txt

############################################
# 4) speaking_service：忽略 runs，但保留“代码资产”
############################################
# runs 基本都是运行产物（截图、答案、prefill、临时json）
speaking_service/runs/
speaking_service/runs/**

# 如果你有真正“必须保留到仓库的全局缓存代码/结构”，用 cache_global 目录名更清晰：
# （注意：真正的“缓存内容”建议不上 git；这里只是允许目录结构进仓库，避免你误 ignore 掉）
!speaking_service/cache_global/
!speaking_service/cache_global/**

# speaking_service global cache (core asset, but NOT tracked by git)
speaking_service/cache_global/*.jsonl
speaking_service/cache_global/*.json
speaking_service/cache_global/*.txt
# keep the folder
!speaking_service/cache_global/.gitkeep

############################################
# 5) vocab_service：忽略运行产物/缓存/音频等大文件
############################################
# 运行产物
vocab_service/storage/
vocab_service/storage/**

# 常见输出目录（如果你有）
vocab_service/out/
vocab_service/out/**
vocab_service/output/
vocab_service/output/**

# 如果你把 global_cache / uploaded_vocab_cache 放在 storage 里，它会被上面规则忽略；
# 正确做法是：代码里读取的“持久化目录”由环境变量决定，不靠 git。

# runtime / generated
streamlit_wrt_app/storage/
**/__pycache__/
*.log
*.zip
*.docx
*.xlsx
